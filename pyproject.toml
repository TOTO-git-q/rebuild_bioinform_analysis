[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "auto-bioinfo"
version = "0.1.0"
description = "Automated bioinformatics closed-loop core (lightweight, offline, auditable, reproducible)."
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }
dependencies = [
    "numpy>=1.24",
]

[project.optional-dependencies]
dev = [
    "pytest>=7",
    "ruff>=0.4",
    "mypy>=1.8",
]

[project.scripts]
bioauto = "auto_bioinfo.interfaces.cli:main"

[tool.setuptools.packages.find]
include = ["auto_bioinfo*"]

[tool.setuptools.package-data]
"auto_bioinfo.fixtures" = ["**/*.tsv", "**/*.json"]

[tool.ruff]
line-length = 160
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"]
ignore = ["E501", "B008"]

[tool.pytest.ini_options]
testpaths = ["tests"]
